{
  "name": "pepkio-codon-host-fit-checker",
  "version": "0.1.0",
  "description": "Call the Pepkio Codon Host Fit Checker REST API from Node.js with typed ESM imports, multi-host codon compatibility analysis, and a CLI.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "pepkio-codon-host-fit-checker": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --exclude '**/integration.test.ts'",
    "test:integration": "vitest run integration.test.ts",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pepkio/pepkio-codon-host-fit-checker-js.git"
  },
  "bugs": {
    "url": "https://github.com/pepkio/pepkio-codon-host-fit-checker-js/issues"
  },
  "homepage": "https://www.pepkio.com/tools/codon-host-fit-checker",
  "keywords": [
    "codon-host-fit-checker",
    "codon-optimization",
    "cai",
    "codon-adaptation-index",
    "host-expression",
    "codon-bias",
    "rare-codons",
    "mrna-folding",
    "gc-content",
    "recombinant-protein",
    "molecular-biology",
    "synthetic-biology",
    "bioinformatics",
    "pepkio",
    "laboratory-tools",
    "life-sciences",
    "typescript",
    "node",
    "rest-api",
    "scientific-computing"
  ],
  "author": "Pepkio Team",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "dotenv": "^16.5.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.1.2"
  }
}
